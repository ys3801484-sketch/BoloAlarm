<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include preferences and database for backup; exclude temporary files -->
        <include domain="database" path="bolo_alarm_database" />
        <include domain="sharedpref" path="bolo_alarm_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="bolo_alarm_database" />
        <include domain="sharedpref" path="bolo_alarm_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
